# ============================================================
# AduanaBilling — Variables de Entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA comitees el archivo .env real al repositorio.
# ============================================================

# --- Django Core ---
SECRET_KEY=django-insecure-reemplaza-esto-con-una-clave-secreta-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de Datos (por defecto usa SQLite en desarrollo) ---
# Para producción se recomienda PostgreSQL:
# DATABASE_URL=postgres://usuario:contrasena@host:5432/nombre_db

# --- Email ---
# Para desarrollo usa 'console' (imprime en terminal):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para producción usa SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion
DEFAULT_FROM_EMAIL=facturacion@aduana.com

# --- Twilio / WhatsApp (Opcional) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
